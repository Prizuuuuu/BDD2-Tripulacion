] AS row
MATCH (a:Tripulante {id_tripulante: row.de}), (b:Tripulante {id_tripulante: row.a})
MERGE (a)-[r:REEMPLAZADO_POR {id_asignacion: row.id_asignacion}]->(b)
SET r.id_cadena = row.id_cadena, r.eslabon = row.eslabon, r.fecha = date(row.fecha), r.id_vuelo = row.id_vuelo, r.motivo = row.motivo, r.aviso_horas = row.aviso_horas;
