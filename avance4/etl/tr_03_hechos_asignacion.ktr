<step><name>E · staging.asignacion_tripulacion + vuelo</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>PG_Staging_U1</connection><sql>SELECT a.id_asignacion, a.id_tripulante, a.id_vuelo, v.fecha_salida_real::date AS fecha_salida,
       upper(trim(o.codigo_iata)) AS origen, upper(trim(d.codigo_iata)) AS destino, a.rol, a.horas_vuelo,
       v.retraso_minutos, round(extract(epoch FROM v.fecha_llegada_real - v.fecha_salida_real) / 3600, 2) AS duracion_h
FROM staging.asignacion_tripulacion a
JOIN staging.vuelo v ON v.id_vuelo = a.id_vuelo
JOIN staging.aeropuerto o ON o.id_aeropuerto = v.id_aeropuerto_origen
JOIN staging.aeropuerto d ON d.id_aeropuerto = v.id_aeropuerto_destino
ORDER BY a.id_asignacion</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active>
<attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>60</xloc><yloc>200</yloc><draw>Y</draw></GUI></step>
