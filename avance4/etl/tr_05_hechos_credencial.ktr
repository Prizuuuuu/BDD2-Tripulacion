<connection>PG_Staging_U1</connection><sql>SELECT 'C-' || c.id_certificacion AS id_credencial, c.id_tripulante, 'PostgreSQL (U1)' AS fuente,
       'Certificación' AS categoria, c.tipo_certificacion AS tipo, initcap(c.estado) AS estado,
       c.fecha_emision, c.fecha_vencimiento
FROM staging.certificacion c
ORDER BY c.id_certificacion</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active>
