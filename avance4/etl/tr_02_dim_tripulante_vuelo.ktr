<step><name>E · staging.vuelo</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>PG_Staging_U1</connection><sql>SELECT v.id_vuelo, trim(v.numero_vuelo) AS numero_vuelo,
       upper(trim(o.codigo_iata)) || '-' || upper(trim(d.codigo_iata)) AS ruta,
       round(extract(epoch FROM v.fecha_llegada_real - v.fecha_salida_real) / 3600, 2) AS duracion_h,
       v.estado AS estado_vuelo,
       CASE WHEN extract(hour FROM v.fecha_salida_real) &lt; 6 THEN 'Madrugada'
            WHEN extract(hour FROM v.fecha_salida_real) &lt; 12 THEN 'Mañana'
            WHEN extract(hour FROM v.fecha_salida_real) &lt; 18 THEN 'Tarde' ELSE 'Noche' END AS franja_salida
FROM staging.vuelo v
JOIN staging.aeropuerto o ON o.id_aeropuerto = v.id_aeropuerto_origen
JOIN staging.aeropuerto d ON d.id_aeropuerto = v.id_aeropuerto_destino
ORDER BY v.id_vuelo</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active>
<attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>80</xloc><yloc>260</yloc><draw>Y</draw></GUI></step>
