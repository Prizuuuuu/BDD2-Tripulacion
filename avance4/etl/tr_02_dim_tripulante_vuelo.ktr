<step><name>E · staging.tripulante + base</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>PG_Staging_U1</connection><sql>SELECT t.id_tripulante, trim(t.numero_empleado) AS numero_empleado,
       trim(t.nombre) || ' ' || trim(t.apellido) AS nombre_completo, t.cargo,
       CASE WHEN t.cargo IN ('PILOTO','COPILOTO') THEN 'Cabina de mando' ELSE 'Cabina de pasajeros' END AS grupo,
       initcap(t.estado) AS estado, t.fecha_ingreso,
       floor((DATE '2026-06-30' - t.fecha_ingreso) / 365.25)::int AS anios_antiguedad,
       CASE WHEN (DATE '2026-06-30' - t.fecha_ingreso) / 365.25 &lt; 3 THEN '0-2 años'
            WHEN (DATE '2026-06-30' - t.fecha_ingreso) / 365.25 &lt; 10 THEN '3-9 años' ELSE '10+ años' END AS rango_antiguedad,
       upper(trim(a.codigo_iata)) AS base_iata, trim(a.ciudad) AS base_ciudad, r.nombre_region AS base_region
FROM staging.tripulante t
JOIN staging.hub h ON h.id_hub = t.id_hub_base
JOIN staging.aeropuerto a ON a.id_aeropuerto = h.id_aeropuerto
JOIN staging.region r ON r.id_region = a.id_region
ORDER BY t.id_tripulante</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active>
<attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI></step>
<step><name>T · Cargo en lenguaje de negocio</name><type>ValueMapper</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<field_to_use>cargo</field_to_use><target_field/><non_match_default/><fields><field><source_value>PILOTO</source_value><target_value>Piloto</target_value></field><field><source_value>COPILOTO</source_value><target_value>Copiloto</target_value></field><field><source_value>JEFE_CABINA</source_value><target_value>Jefe de cabina</target_value></field><field><source_value>AUXILIAR_VUELO</source_value><target_value>Auxiliar de vuelo</target_value></field></fields>
