<step><name>E · staging.aeropuerto + hub</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>PG_Staging_U1</connection><sql>SELECT a.id_aeropuerto, upper(trim(a.codigo_iata)) AS codigo_iata, trim(a.nombre) AS nombre, trim(a.ciudad) AS ciudad,
       upper(a.estado) AS estado, (h.id_hub IS NOT NULL)::int AS es_hub, a.id_region
FROM staging.aeropuerto a LEFT JOIN staging.hub h ON h.id_aeropuerto = a.id_aeropuerto
ORDER BY a.id_aeropuerto</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active>
