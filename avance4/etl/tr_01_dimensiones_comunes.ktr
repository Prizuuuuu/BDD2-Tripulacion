<step><name>E · dim_tiempo (generate_series)</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>PG_Staging_U1</connection><sql>SELECT to_char(d, 'YYYYMMDD')::int AS sk_tiempo, d::date AS fecha,
       extract(year FROM d)::int AS anio, extract(quarter FROM d)::int AS trimestre, extract(month FROM d)::int AS mes,
       (ARRAY['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'])[extract(month FROM d)] AS nombre_mes,
       to_char(d, 'YYYY-MM') AS anio_mes, extract(week FROM d)::int AS semana_iso, extract(isodow FROM d)::int AS dia_semana,
       (ARRAY['Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'])[extract(isodow FROM d)] AS nombre_dia,
       (extract(isodow FROM d) &gt;= 6)::int AS es_fin_semana
FROM generate_series('2024-01-01'::date, '2028-12-31'::date, interval '1 day') AS d</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active>
<attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI></step>
