<entry><name>Preparar carga (vaciar Data Mart)</name><description/><type>SQL</type><attributes/><sql>USE dm_tripulacion;
SET FOREIGN_KEY_CHECKS = 0;
TRUNCATE TABLE fact_asignacion; TRUNCATE TABLE fact_jornada; TRUNCATE TABLE fact_credencial;
TRUNCATE TABLE dim_credencial; TRUNCATE TABLE dim_vuelo; TRUNCATE TABLE dim_tripulante;
TRUNCATE TABLE dim_aeropuerto; TRUNCATE TABLE dim_region; TRUNCATE TABLE dim_tiempo;
TRUNCATE TABLE stg_asignacion; TRUNCATE TABLE stg_jornada; TRUNCATE TABLE stg_credencial; TRUNCATE TABLE etl_rechazos;
SET FOREIGN_KEY_CHECKS = 1;</sql><useVariableSubstitution>F</useVariableSubstitution><sqlfromfile>F</sqlfromfile><sqlfilename/><sendOneStatement>F</sendOneStatement><connection>MySQL_DM</connection><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>260</xloc><yloc>80</yloc><attributes_kjc/></entry>
