<calculation><field_name>margen_60h_semana</field_name><calc_type>SUBTRACT</calc_type><field_a>limite_semana_h</field_a><field_b>horas_servicio_7d</field_b><field_c/><value_type>Number</value_type><value_length>-1</value_length><value_precision>2</value_precision><remove>N</remove><conversion_mask/><decimal_symbol/><grouping_symbol/><currency_symbol/></calculation>
