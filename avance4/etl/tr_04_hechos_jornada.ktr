<step><name>E · staging.jornada_laboral (descanso y 7 días)</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>PG_Staging_U1</connection><sql>WITH j AS (
  SELECT j.*,
         round(extract(epoch FROM j.hora_inicio - lag(j.hora_fin) OVER w) / 3600, 2) AS descanso_previo_h,
         sum(j.horas_servicio) OVER (PARTITION BY j.id_tripulante ORDER BY j.hora_inicio
                                     RANGE BETWEEN interval '167 hours' PRECEDING AND CURRENT ROW) AS horas_servicio_7d
  FROM staging.jornada_laboral j
  WHERE j.hora_fin &gt; j.hora_inicio
  WINDOW w AS (PARTITION BY j.id_tripulante ORDER BY j.hora_inicio)),
vu AS (
  SELECT a.id_tripulante, v.fecha_salida_real::date AS fecha, count(*) AS tramos, sum(a.horas_vuelo) AS horas
  FROM staging.asignacion_tripulacion a JOIN staging.vuelo v ON v.id_vuelo = a.id_vuelo
  GROUP BY 1, 2)
SELECT j.id_jornada, j.id_tripulante, j.fecha_jornada, j.tipo_jornada, j.horas_servicio,
       coalesce(vu.tramos, 0) AS tramos_volados, coalesce(vu.horas, 0) AS horas_vuelo_dia,
       j.descanso_previo_h, j.horas_servicio_7d, 60.0 AS limite_semana_h
FROM j LEFT JOIN vu ON vu.id_tripulante = j.id_tripulante AND vu.fecha = j.fecha_jornada
ORDER BY j.id_jornada</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active>
<attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>80</xloc><yloc>120</yloc><draw>Y</draw></GUI></step>
